# Environment Variables for Zenox Gmail Exchange Telegram Bot (Cloudflare Workers)
# Copy this file to `.dev.vars` for local `npx wrangler dev` testing.
# In production, set BOT_TOKEN via `npx wrangler secret put BOT_TOKEN` or Cloudflare Dashboard.

BOT_TOKEN="1234567890:AAH_YOUR_TELEGRAM_BOT_TOKEN_HERE"
OWNER_ID="123456789"
SUPPORT_USERNAME="@ZenoxWorker"
FORCE_CHANNEL="@ZenoxUpdates"
UPI_DETAILS="zenoxexchange@upi (Scan QR or Pay to UPI ID & submit 12-digit UTR)"

# AI Studio Runtime Environment Variables (kept for studio preview compatibility)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
